function add(a: int, b: int): int:
    return a + b

function greet(name: str):
    output("Hello, ", name)
    
function factorial(n: int): int:
    when n <= 1:
        return 1
    else:
        return n * factorial(n - 1)

function fibonacci(n: int): int:
    when n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)