flex total = 0
while age > 0:
    total += age
    age -= 1
    when age == 10 and not flag:
        break
    when age == 5 or flag:
        output("checkpoint")

for index in range(5):
    when index == 2:
        continue
    when index == 4:
        break
    output(index)

when flag and total > 0:
